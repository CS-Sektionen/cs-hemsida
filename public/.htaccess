# Apache config for the site on Loopia Unix. Vite copies this into dist/.

# Serve real files as-is, send every other path to the React app, which
# picks the page (or the 404 page) from the URL.
# DirectorySlash is off because Apache sits behind Loopia's nginx and would
# redirect /kontakt to http://.../kontakt/, dropping HTTPS for one hop.
DirectorySlash Off
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# Vite puts a content hash in every filename under /assets, so those can be
# cached forever. The HTML must always be revalidated to pick up new builds.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
